  <SynchronizationOptions xsi:type="PgSqlDgDataSynchronizationOptions">
    <SynchronizeType>File</SynchronizeType>
    <ExecuteCustomScriptTypeBefore>None UseEmbeddedScript</ExecuteCustomScriptTypeBefore>
    <ExecuteCustomScriptTypeAfter>None Execute UseEmbeddedScript</ExecuteCustomScriptTypeAfter>
    <EmbeddedScriptAfter>UPDATE sales.order_items AS oi 
SET unit_price = p.unit_price 
FROM sales.products AS p 
WHERE p.product_id = oi.product_id;</EmbeddedScriptAfter>
